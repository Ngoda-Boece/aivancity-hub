# Copiez ce fichier en backend/.env puis complétez. Tout est facultatif sauf
# JWT_SECRET en production : sans clé, la fonction concernée se désactive proprement.

# --- Serveur ---------------------------------------------------------------
PORT=3000
# NODE_ENV=production
# Chaîne aléatoire ≥ 32 caractères (obligatoire en production) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=12
# Derrière un reverse proxy (Render, Fly, Nginx…) :
# TRUST_PROXY=true
# DATA_DIR=./data

# --- Connexion ---------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=aivancity.ai,aivancity.education
# Connexion par simple e-mail (sans preuve d'identité). Passez à false une fois le SSO Microsoft actif.
ALLOW_LOCAL_LOGIN=true

# SSO Microsoft (Entra ID) — active aussi l'agenda Outlook et l'envoi d'e-mails.
# Inscription d'application : https://entra.microsoft.com → App registrations
#   Redirect URI (Web) : http://localhost:3000/api/auth/microsoft/callback
#   Permissions déléguées : User.Read, Calendars.Read, Mail.Send, offline_access
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=organizations
# MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Assistants IA (Mistral) -------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_MAX_TOKENS=1200
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# --- E-mails (réservations) --------------------------------------------------
# Sans SMTP ni SSO Microsoft, l'app ouvre un brouillon pré-rempli dans la messagerie de l'étudiant.
BOOKING_RECIPIENT=assim.ahmed@aivancity.education
BDE_EMAIL=bde@aivancity.ai
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hub@aivancity.ai
# SMTP_PASS=
# SMTP_FROM=hub@aivancity.ai

# --- Données -----------------------------------------------------------------
# Google Sheets → Fichier → Partager → Publier sur le web → CSV
# Colonnes reconnues : Nom/Name (ou Prénom + Nom), Email, Points/Score/Total
# AIPOINTS_SHEET_CSV_URL=
# Flux ICS commun à toute l'école (chaque étudiant peut aussi ajouter le sien) :
# SCHEDULE_ICS_URL=
# Restreindre les domaines autorisés pour les liens ICS (ex. outlook.office365.com,calendar.google.com) :
# ICS_ALLOWED_HOSTS=

# --- Synchro locale Blackboard/Aimara (uniquement si le serveur tourne sur VOTRE PC) ---
# npm install playwright && npx playwright install chromium
ENABLE_SCRAPING=false
